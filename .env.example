CI_ENVIRONMENT = development
app.baseURL = 'http://localhost/ProjetoKairon/'
app.indexPage = ''
app.appTimezone = 'America/Sao_Paulo'

# SQLite local fica em writable/kairon.sqlite3. Para MySQL, descomente:
database.default.DBDriver = MySQLi
database.default.hostname = 127.0.0.1
database.default.database = kairon
database.default.username = root
database.default.password = ''
database.default.port = 3306

# Ative somente depois de configurar o SMTP da instituição.
kairon.emailEnabled = false
email.protocol = smtp
email.SMTPHost = ''
email.SMTPUser = ''
email.SMTPPass = ''
email.SMTPPort = 587
email.SMTPCrypto = tls
email.fromEmail = 'agenda@example.com'
email.fromName = 'Kairon | Agenda de ensino'

# Em produção: HTTPS e cookies seguros.
# CI_ENVIRONMENT = production
# app.forceGlobalSecureRequests = true
# cookie.secure = true
